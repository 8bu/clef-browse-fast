# Copy to .env (git-ignored) and fill in. Never commit real values.

# Cloudflare Workers AI, Clef decision model (required)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
# Decision model. Only "clef" is supported.
CLEF_MODEL=clef

# OpenAI-compatible text provider, used only for TYPE_TEXT (required when a task types text)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat
TEXT_MODEL_REASONING=

# BrowserOS Neo (attach to the running app; no separate browser is launched)
BROWSEROS_NEO_MCP_URL=http://127.0.0.1:9010/mcp
BROWSEROS_NEO_CDP_URL=http://127.0.0.1:9111

# Per-run limits
CLEF_BROWSE_MAX_STEPS=60
CLEF_BROWSE_TIMEOUT_S=180
CLEF_BROWSE_MAX_MODEL_CALLS=120
